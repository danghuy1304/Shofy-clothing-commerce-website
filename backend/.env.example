# FastAPI Configuration
PROJECT_NAME="Shofy Fashion E-Commerce API"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-in-production"

# Supabase Configuration
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Gemini AI (required for /api/v1/ai/* routes)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# CORS — when running via Docker+nginx on port 80, add http://localhost
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost","http://localhost:80"]
