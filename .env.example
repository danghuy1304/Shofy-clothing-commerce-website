# =============================================================================
# Shofy Docker Environment — copy file này thành .env rồi điền giá trị thật
# =============================================================================

# ── FastAPI Backend ────────────────────────────────────────────────────────────
PROJECT_NAME="Shofy Fashion E-Commerce API"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-in-production"

# Supabase — lấy từ Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI — cần để dùng tính năng AI Stylist
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# CORS — thêm http://localhost cho Docker+nginx
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost"]

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_PORT=80
FRONTEND_PORT=3000
